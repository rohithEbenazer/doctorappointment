{
  "name": "doctor-appointment-platform",
  "version": "1.0.0",
  "description": "Full Hospital Doctor Appointment Platform",
  "main": "server/src/server.js",
  "scripts": {
    "server": "node server/src/server.js",
    "client": "npm --prefix client run dev",
